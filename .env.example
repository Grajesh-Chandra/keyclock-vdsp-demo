# Application Configuration
NODE_ENV=development
PORT=3000
SESSION_SECRET=change-this-to-a-random-secure-string-in-production

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8880
KEYCLOAK_REALM=vdsp-demo
KEYCLOAK_CLIENT_ID=vdsp-demo-app
KEYCLOAK_CLIENT_SECRET=demo-secret-change-in-production

# Application URLs
APP_URL=http://localhost:3000
REDIRECT_URI=http://localhost:3000/callback

# Database (if using PostgreSQL for Keycloak)
DB_VENDOR=h2
DB_ADDR=localhost
DB_PORT=5432
DB_DATABASE=keycloak
DB_USER=keycloak
DB_PASSWORD=keycloak-password
